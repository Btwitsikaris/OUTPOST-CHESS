{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ws.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/mainpage", "destination": "/public/mainpage.html" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}
